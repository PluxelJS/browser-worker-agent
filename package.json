{
	"name": "@pluxel/browser-worker-agent",
	"version": "0.1.0",
	"type": "module",
	"description": "Browser agent sessions and capability-backed JavaScript Workers",
	"files": [
		"dist",
		"README.md"
	],
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/types/index.d.ts",
			"import": "./dist/index.js"
		},
		"./worker": "./dist/execution.worker.js",
		"./execution": {
			"development": "./src/execution.ts",
			"types": "./dist/types/execution.d.ts",
			"import": "./dist/execution.js"
		},
		"./vite": {
			"development": "./src/vite.ts",
			"types": "./dist/types/vite.d.ts",
			"import": "./dist/vite.js"
		}
	},
	"scripts": {
		"build": "node build.mjs && tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit --pretty false",
		"test": "vitest run",
		"test:browser": "node tests/browser-imports.mjs && node tests/core-browser.mjs && node tests/provider-browser.mjs && node tests/customization-browser.mjs && node tests/example-browser.mjs",
		"test:providers": "node tests/provider-browser.mjs",
		"test:pack": "node tests/pack-smoke.mjs",
		"verify": "pnpm typecheck && pnpm test && pnpm test:pack && pnpm test:browser",
		"build:all": "pnpm build && pnpm --dir packages/react build && pnpm --dir packages/ui build",
		"test:example": "node tests/example-browser.mjs",
		"catalog:add": "pncat add",
		"catalog:migrate": "pncat migrate --yes --no-install",
		"catalog:clean": "pncat clean --yes --no-install",
		"catalog:detect": "pncat detect --yes"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "catalog:frontend",
		"@earendil-works/pi-agent-core": "catalog:frontend"
	},
	"devDependencies": {
		"@assistant-ui/react": "catalog:frontend",
		"react": "catalog:frontend",
		"react-dom": "catalog:frontend",
		"@types/react": "catalog:frontend",
		"@types/react-dom": "catalog:frontend",
		"tailwindcss": "catalog:frontend",
		"vite": "catalog:tooling",
		"rolldown": "catalog:tooling",
		"typescript": "catalog:tooling",
		"vitest": "catalog:test",
		"playwright": "catalog:test",
		"fake-indexeddb": "catalog:test",
		"@tailwindcss/vite": "catalog:frontend",
		"@streamdown/code": "catalog:frontend",
		"capnweb": "catalog:backend",
		"pncat": "catalog:tooling"
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/types/index.d.ts",
				"import": "./dist/index.js"
			},
			"./worker": "./dist/execution.worker.js",
			"./execution": {
				"types": "./dist/types/execution.d.ts",
				"import": "./dist/execution.js"
			},
			"./vite": {
				"types": "./dist/types/vite.d.ts",
				"import": "./dist/vite.js"
			}
		}
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/PluxelJS/browser-worker-agent.git"
	},
	"packageManager": "pnpm@11.28.0",
	"engines": {
		"node": ">=24",
		"pnpm": ">=11 <12"
	},
	"peerDependencies": {
		"capnweb": "^0.12.0",
		"vite": "^8.3.1"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		}
	}
}
